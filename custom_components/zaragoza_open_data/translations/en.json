  "services": {
    "find_stops": {
      "name": "Find stops",
      "description": "Finds tram stops, bus stops or Bizi stations by name, number, street or line, nearest first: from home, or from a point.",
      "fields": {
        "kind": {
          "name": "Kind",
          "description": "Tram stops, bus stops or Bizi stations."
        },
        "query": {
          "name": "Text",
          "description": "Part of a name, a number, a street or a line. Accents and case don't matter. Without it, the nearest are returned."
        },
        "latitude": {
          "name": "Latitude",
          "description": "Latitude of the point to measure from, together with the longitude. Without a point, home."
        },
        "longitude": {
          "name": "Longitude",
          "description": "Longitude of the point to measure from, together with the latitude. Without a point, home."
        },
        "limit": {
          "name": "Limit",
          "description": "How many to return, at most 50."
        }
      }
    },
    "get_arrivals": {
      "name": "Get arrivals",
      "description": "Gets the next trams or buses at any stop, whether or not it is added: line, destination, minutes and time.",
      "fields": {
        "mode": {
          "name": "Mode",
          "description": "Tram or bus."
        },
        "stop": {
          "name": "Stop",
          "description": "The stop's number, as find_stops returns it; for a bus stop, the number on its sign."
        }
      }
    },
    "get_bizi_station": {
      "name": "Get Bizi station",
      "description": "Gets the bikes, by type, and free docks at any Bizi station, whether or not it is added.",
      "fields": {
        "station": {
          "name": "Station",
          "description": "The station's number, as in its name."
        }
      }
    }
  },
  "exceptions": {
    "tram_unavailable": {
      "message": "The city's tram arrivals can't be reached"
    },
    "bus_unavailable": {
      "message": "No bus stop has arrivals from the last 10 minutes: neither the operator nor the city answers"
    },
    "bizi_unavailable": {
      "message": "Neither the Bizi operator nor the city's Bizi list can be reached"
    },
    "road_works_unavailable": {
      "message": "The city's road works lists can't be reached"
    },
    "pharmacies_unavailable": {
      "message": "The city's list of pharmacies on duty can't be reached"
    },
    "air_quality_unavailable": {
      "message": "The city's air quality readings can't be reached"
    },
    "pollen_unavailable": {
      "message": "The city's pollen levels can't be reached"
    },
    "unknown_stop": {
      "message": "No stop or station has the code {code}"
    },
    "kind_disabled": {
      "message": "That kind of stop is switched off in the integration's options"
    },
    "source_unavailable": {
      "message": "The source of this data can't be reached right now"
    },
    "station_without_counts": {
      "message": "The source answering now has no bike or dock counts for station {code}"
    },
    "not_loaded": {
      "message": "Zaragoza Open Data isn't running: reload it and try again"
    }
  },
  "issues": {
    "stop_vanished": {
      "title": "{title} is no longer listed",
      "fix_flow": {
        "step": {
          "confirm": {
            "title": "Remove {title}?",
            "description": "{title} has been missing from its source's list for over a day: it was probably renumbered or removed. Submit to remove it, with its device and sensors. If it was renumbered, add it again under its new number."
          }
        }
      }
    }
  }
}
