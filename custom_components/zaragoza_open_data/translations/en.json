{
  "title": "Zaragoza Open Data",
  "config": {
    "step": {
      "user": {
        "description": "Choose what to bring in from Zaragoza's open data. You can change this later in the options.",
        "data": {
          "kinds": "Data"
        },
        "data_description": {
          "kinds": "Stops and stations are added afterwards, from the integration's entry."
        }
      }
    },
    "error": {
      "no_kinds": "Tick at least one kind of data.",
      "cannot_connect": "Can't reach the city's open data service or the Bizi operator. Try again in a few minutes."
    },
    "abort": {
      "single_instance_allowed": "Zaragoza Open Data is already set up. Change it from its options."
    }
  },
  "config_subentries": {
    "tram_stop": {
      "entry_type": "Tram stop",
      "initiate_flow": {
        "user": "Add tram stop"
      },
      "step": {
        "user": {
          "title": "Add tram stop",
          "description": "Every platform, nearest first. Type to search by stop name or direction.",
          "data": {
            "stop": "Tram stop"
          },
          "data_description": {
            "stop": "Each stop has one platform per direction."
          }
        },
        "place": {
          "title": "Near another place",
          "description": "Drop the pin where the list should be measured from.",
          "data": {
            "location": "Place"
          }
        }
      },
      "error": {
        "cannot_connect": "Can't reach the city's open data service. Wait a moment and submit to try again.",
        "pick_from_list": "Pick a stop from the list."
      },
      "abort": {
        "kind_disabled": "Tram is switched off. Turn it on in the integration's options first.",
        "already_configured": "This tram stop is already added.",
        "entry_not_loaded": "Zaragoza Open Data isn't running. Reload it, then try again."
      }
    },
    "bus_stop": {
      "entry_type": "Bus stop",
      "initiate_flow": {
        "user": "Add bus stop",
        "reconfigure": "Change lines"
      },
      "step": {
        "user": {
          "title": "Add bus stop",
          "description": "Every stop, nearest first. Type to search by stop number, street or line.",
          "data": {
            "stop": "Bus stop"
          },
          "data_description": {
            "stop": "The number is on the stop's sign."
          }
        },
        "place": {
          "title": "Near another place",
          "description": "Drop the pin where the list should be measured from.",
          "data": {
            "location": "Place"
          }
        },
        "lines": {
          "title": "Lines",
          "description": "Tick the lines to show at this stop. With none ticked, every line is shown.",
          "data": {
            "lines": "Lines"
          }
        },
        "reconfigure": {
          "title": "Change lines",
          "description": "Tick the lines to show at this stop. With none ticked, every line is shown.",
          "data": {
            "lines": "Lines"
          }
        }
      },
      "error": {
        "cannot_connect": "Can't reach the city's open data service. Wait a moment and submit to try again.",
        "pick_from_list": "Pick a stop from the list, or type its exact number."
      },
      "abort": {
        "kind_disabled": "Bus is switched off. Turn it on in the integration's options first.",
        "already_configured": "This bus stop is already added.",
        "entry_not_loaded": "Zaragoza Open Data isn't running. Reload it, then try again.",
        "cannot_connect": "Can't reach the city's open data service to list the stop's lines. Try again in a few minutes."
      }
    },
    "bizi_station": {
      "entry_type": "Bizi station",
      "initiate_flow": {
        "user": "Add Bizi station"
      },
      "step": {
        "user": {
          "title": "Add Bizi station",
          "description": "Every station, nearest first. Type to search by station number or name.",
          "data": {
            "station": "Bizi station"
          }
        },
        "place": {
          "title": "Near another place",
          "description": "Drop the pin where the list should be measured from.",
          "data": {
            "location": "Place"
          }
        }
      },
      "error": {
        "cannot_connect": "Can't reach the Bizi operator or the city's open data service. Wait a moment and submit to try again.",
