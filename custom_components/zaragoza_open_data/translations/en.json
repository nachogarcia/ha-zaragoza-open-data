      },
      "abort": {
        "kind_disabled": "Bizi bikes are switched off. Turn them on in the integration's options first.",
        "already_configured": "This Bizi station is already added.",
        "entry_not_loaded": "Zaragoza Open Data isn't running. Reload it, then try again."
      }
    }
